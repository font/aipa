# LLM Provider Configuration
# Choose one: llamastack, anthropic, openai
LLM_PROVIDER=anthropic
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# LlamaStack Configuration (if using llamastack provider)
LLAMASTACK_API_URL=http://localhost:8000
LLAMASTACK_MODEL=llama2

# Anthropic Configuration (if using anthropic provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# OpenAI Configuration (if using openai provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# RAG Configuration
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3

# Policy Configuration
POLICY_DIR=data

# Debug
DEBUG=true
